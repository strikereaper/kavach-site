---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
---
<Base title="Page not found · Kavach" description="This page does not exist." height={1200}>
<section style="max-width: 1200px; margin: 0 auto; padding: 120px 24px 160px; display: flex; flex-direction: column; gap: 22px">
<p style="margin: 0; font-family: 'JetBrains Mono Variable', monospace; font-size: 14px; color: var(--kv-ink-2)">404 · PAGE_1</p>
<h1 style="margin: 0; font-family: 'Anek Latin Variable', sans-serif; font-weight: 650; font-stretch: 85%; font-size: clamp(44px, 6vw, 80px); line-height: 0.98">This page has been redacted.</h1>
<p style="margin: 0; font-size: 20px; color: var(--kv-ink-2)">Or it never existed. Either way, there’s nothing here.</p>
<a class="kv-btn" href={u('')} style="align-self: flex-start; background: var(--kv-indigo); color: var(--kv-paper); text-decoration: none; padding: 15px 24px; border-radius: 6px; font-weight: 600">Back to the home page</a>
</section>
</Base>
