---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
import { renderAll } from '../lib/dc';
import { Component } from '../logic/index.js';
const tpl = import.meta.glob('../templates/index/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const html = renderAll(new Component({}), tpl);
---
<Base title="Kavach \u00b7 PII redaction for India, on your own servers" description="Kavach masks Aadhaar, PAN, names, phone numbers and addresses in AI agent traffic, calls and scanned documents, in 10 Indian languages, Hinglish and English. It runs on your own servers." current="" height={10400}>
<!-- HERO -->
<section style="max-width: 1200px; margin: 0 auto; padding: 72px 24px 64px; display: flex; flex-wrap: wrap; gap: 56px; align-items: center">
<div style="flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 24px">
<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px">
<p style="margin: 0; font-size: 16px; font-weight: 600; color: var(--kv-indigo)">On-prem PII redaction for India</p>
<span aria-hidden="true" style="display: inline-flex; align-items: center; gap: 8px; font-family: 'JetBrains Mono Variable', monospace; font-size: 13px; padding: 3px 10px; border: 1px solid var(--kv-line); border-radius: 4px; background: var(--kv-paper)"><span class="kv-cycle" style="font-family: 'Mukta', 'Anek Devanagari Variable', 'Anek Kannada Variable', 'Anek Tamil Variable', 'Anek Bangla Variable', sans-serif; font-size: 15px; color: var(--kv-vermilion-deep); min-width: 74px"><span class="kv-cycle-in"><span>राहुल</span><span>ಸುರೇಶ್</span><span>லக்ஷ்மி</span><span>সৌমিত্র</span><span>Anjali</span><span>राहुल</span></span></span><span style="color: var(--kv-muted)">→</span><span style="background: var(--kv-indigo); color: var(--kv-khadi); padding: 1px 6px; border-radius: 3px">PERSON_1</span></span>
</div>
<h1 style="margin: 0; font-family: 'Anek Latin Variable', sans-serif; font-weight: 650; font-stretch: 85%; font-size: clamp(44px, 6vw, 80px); line-height: 0.98; letter-spacing: -0.02em; text-wrap: balance">Personal data, masked in the languages India speaks.</h1>
<p style="margin: 0; font-size: 20px; line-height: 1.55; color: var(--kv-ink-2); max-width: 560px; text-wrap: pretty">Kavach finds Aadhaar, PAN, names, phone numbers and addresses in AI agent traffic, phone calls and scanned documents, across 10 Indian languages, Hinglish and English. It runs inside your network, so nothing is sent to us or anyone else.</p>
<div style="display: flex; flex-wrap: wrap; gap: 12px">
<a class="kv-btn" href={u('pilot/')} style="background: var(--kv-indigo); color: var(--kv-paper); text-decoration: none; padding: 15px 24px; border-radius: 6px; font-weight: 600; font-size: 17px">Book a free pilot</a>
<a class="kv-btn2" href="#products" style="color: var(--kv-ink); text-decoration: none; padding: 14px 24px; border-radius: 6px; font-weight: 600; font-size: 17px; border: 1px solid var(--kv-ink)">See the products</a>
</div>
</div>

<!-- LIVE CALL CARD -->
<div style="flex: 1 1 460px; min-width: 0; position: relative; padding-top: 24px">
<span class="kv-glyph" aria-hidden="true" style="position: absolute; left: 50%; top: 46%; transform: translate(-50%, -50%); z-index: 0; font-family: 'Anek Devanagari Variable', sans-serif; font-weight: 700; font-size: clamp(160px, 21vw, 300px); line-height: 1; white-space: nowrap; color: transparent; -webkit-text-stroke: 1.2px var(--kv-stone); pointer-events: none; user-select: none">कवच</span>
<div class="kv-live" style="position: relative; z-index: 1; background: var(--kv-paper); border: 1px solid var(--kv-line); border-radius: 10px; box-shadow: 0 30px 60px -30px rgba(22, 26, 46, 0.35); overflow: hidden">
<div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 20px; border-bottom: 1px solid var(--kv-line-soft); font-size: 14px; color: var(--kv-ink-2)">
<span style="display: flex; align-items: center; gap: 8px"><span class="kv-dot" aria-hidden="true" style="width: 8px; height: 8px; border-radius: 50%; background: var(--kv-vermilion)"></span>Live call · support line</span>
<span style="font-family: 'JetBrains Mono Variable', monospace; font-size: 13px">Hindi · English · Kannada</span>
</div>
<div aria-hidden="true" style="height: 72px; display: flex; align-items: center; gap: 3px; padding: 0 20px; background: var(--kv-khadi)" set:html={html.heroWave}></div>
<div style="padding: 22px 20px 8px; display: flex; flex-direction: column; gap: 14px; font-size: 18px; line-height: 1.6">
<p style="margin: 0"><span style="color: var(--kv-muted); font-size: 13px; font-family: 'JetBrains Mono Variable', monospace; margin-right: 8px">CALLER</span>Mera naam <span class="pii">Ramesh Kumar<span class="pii-bar" style="animation-delay: 0.4s"></span><span class="pii-tok" style="animation-delay: 0.4s">PERSON_1</span></span> hai</p>
<p style="margin: 0"><span style="color: var(--kv-muted); font-size: 13px; font-family: 'JetBrains Mono Variable', monospace; margin-right: 8px">CALLER</span>मेरा आधार <span class="pii">2345 6789 0123<span class="pii-bar" style="animation-delay: 1.2s"></span><span class="pii-tok" style="animation-delay: 1.2s">AADHAAR_1</span></span> है</p>
<p style="margin: 0"><span style="color: var(--kv-muted); font-size: 13px; font-family: 'JetBrains Mono Variable', monospace; margin-right: 8px">CALLER</span>number <span class="pii">nau aath chaar paanch zero<span class="pii-bar" style="animation-delay: 2s"></span><span class="pii-tok" style="animation-delay: 2s">PHONE_1</span></span></p>
<p style="margin: 0"><span style="color: var(--kv-muted); font-size: 13px; font-family: 'JetBrains Mono Variable', monospace; margin-right: 8px">CALLER</span>ವಿಳಾಸ <span class="pii">14, ಜಯನಗರ<span class="pii-bar" style="animation-delay: 2.8s"></span><span class="pii-tok" style="animation-delay: 2.8s">ADDRESS_1</span></span></p>
</div>
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; padding: 14px 20px 18px; font-size: 13px; color: var(--kv-muted); font-family: 'JetBrains Mono Variable', monospace">
<span>4 entities masked</span><span>audit record written · no PII stored</span>
</div>
</div>
<svg class="kv-stamp" role="img" aria-label="Stamp: on your servers, zero egress" width="128" height="128" viewBox="0 0 132 132" style="position: absolute; top: -18px; right: 12px; z-index: 2; transform: rotate(-12deg); opacity: 0.95">
<defs><path id="kvStampPath" d="M66 66 m-49 0 a49 49 0 1 1 98 0 a49 49 0 1 1 -98 0"></path></defs>
<circle cx="66" cy="66" r="62" fill="#F4F1E8" stroke="#C2410C" stroke-width="2.4"></circle>
<circle cx="66" cy="66" r="37" fill="none" stroke="#C2410C" stroke-width="1.2"></circle>
<text font-family="JetBrains Mono Variable, monospace" font-size="10.5" font-weight="500" fill="#C2410C"><textPath href="#kvStampPath" textLength="304" lengthAdjust="spacing">ON YOUR SERVERS · ZERO EGRESS ·</textPath></text>
<text x="66" y="73" text-anchor="middle" font-family="Anek Devanagari Variable, sans-serif" font-size="22" font-weight="600" fill="#C2410C">कवच</text>
</svg>
</div>
</section>

<!-- PROOF STRIP -->
<section aria-label="Key numbers" style="border-top: 1px solid var(--kv-line); border-bottom: 1px solid var(--kv-line)">
<div style="max-width: 1200px; margin: 0 auto; padding: 36px 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 28px">
<div style="display: flex; flex-direction: column; gap: 4px"><span style="font-family: 'Anek Latin Variable', sans-serif; font-stretch: 85%; font-size: 44px; font-weight: 650; line-height: 1">90.7%</span><span style="font-size: 15px; line-height: 1.5; color: var(--kv-ink-2)">of PII caught on a 563-document benchmark. The next best open model caught 76%.</span></div>
<div style="display: flex; flex-direction: column; gap: 4px"><span style="font-family: 'Anek Latin Variable', sans-serif; font-stretch: 85%; font-size: 44px; font-weight: 650; line-height: 1">2%</span><span style="font-size: 15px; line-height: 1.5; color: var(--kv-ink-2)">false alarms on documents with no PII. Open alternatives flagged 89 to 100%.</span></div>
<div style="display: flex; flex-direction: column; gap: 4px"><span style="font-family: 'Anek Latin Variable', sans-serif; font-stretch: 85%; font-size: 44px; font-weight: 650; line-height: 1">89.5%</span><span style="font-size: 15px; line-height: 1.5; color: var(--kv-ink-2)">caught in Indian-language documents, where Microsoft Presidio caught 23%.</span></div>
</div>
</section>

<!-- SCROLL STORY -->
<section class="kv-story" style="position: relative">
<div class="kv-story-pin" style="max-width: 1200px; margin: 0 auto; padding: 96px 24px 56px; display: flex; flex-direction: column; gap: 32px">
<div style="position: relative; display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; padding-top: 12px; font-size: 15px; font-weight: 600"><span class="kv-sh-line" aria-hidden="true" style="position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--kv-ink); transform-origin: 0 50%"></span><span style="display: flex; align-items: baseline; gap: 12px"><span lang="hi" style="font-family: 'Anek Devanagari Variable', sans-serif; font-size: 18px; color: var(--kv-indigo)">०१</span><span>Why it exists</span></span><span style="font-family: 'JetBrains Mono Variable', monospace; font-size: 13px; font-weight: 400; color: var(--kv-muted)">01 / 09</span></div>
<h2 style="margin: 0; font-family: 'Anek Latin Variable', sans-serif; font-weight: 650; font-stretch: 85%; font-size: clamp(32px, 4vw, 50px); line-height: 1.04; letter-spacing: -0.015em; max-width: 860px">This is an ordinary Indian support call. English-trained tools miss most of it.</h2>
<p style="margin: 0; font-size: clamp(26px, 3.2vw, 42px); line-height: 1.6; max-width: 1080px; text-wrap: pretty">“Sir, mera naam <span class="pii">Rohit Sharma<span class="pii-hl" style="animation-range: contain 20% contain 24%"></span><span class="pii-bar" style="animation-range: contain 26% contain 32%"></span><span class="pii-tok" style="animation-range: contain 30% contain 33%">PERSON_1</span></span> hai. मेरा आधार <span class="pii">2345 6789 0123<span class="pii-hl" style="animation-range: contain 36% contain 40%"></span><span class="pii-bar" style="animation-range: contain 42% contain 48%"></span><span class="pii-tok" style="animation-range: contain 46% contain 49%">AADHAAR_1</span></span> है, aur phone hai <span class="pii">nau aath chaar paanch<span class="pii-hl" style="animation-range: contain 52% contain 56%"></span><span class="pii-bar" style="animation-range: contain 58% contain 64%"></span><span class="pii-tok" style="animation-range: contain 62% contain 65%">PHONE_1</span></span>. ವಿಳಾಸ <span class="pii">14, 4ನೇ ಬ್ಲಾಕ್, ಜಯನಗರ<span class="pii-hl" style="animation-range: contain 68% contain 72%"></span><span class="pii-bar" style="animation-range: contain 74% contain 80%"></span><span class="pii-tok" style="animation-range: contain 78% contain 81%">ADDRESS_1</span></span>.”</p>
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 24px; border-top: 1px solid var(--kv-line); padding-top: 16px; font-family: 'JetBrains Mono Variable', monospace; font-size: 14px; color: var(--kv-ink-2)">
<span>Entities found: <span class="kv-odo" style="color: var(--kv-ink); font-weight: 500"><span class="kv-odo-in"><span>0</span><span>1</span><span>2</span><span>3</span><span>4</span></span></span> of 4</span>
<span>Hinglish · हिन्दी · ಕನ್ನಡ</span>
<span style="display: inline-grid"><span class="kv-stat-a" style="grid-area: 1 / 1">Scanning on your server…</span><span class="kv-stat-b" style="grid-area: 1 / 1; color: var(--kv-indigo)">All masked · audit written · 0 bytes sent out</span></span>
</div>
</div>
</section>
<section style="max-width: 1200px; margin: 0 auto; padding: 24px 24px 72px">
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 28px">
<div class="rv" style="display: flex; flex-direction: column; gap: 6px"><strong style="font-size: 18px">Three languages in one breath</strong><span style="font-size: 16px; line-height: 1.6; color: var(--kv-ink-2)">People switch scripts and languages mid-sentence. Kavach reads each one natively, not through an English translation.</span></div>
<div class="rv" style="display: flex; flex-direction: column; gap: 6px"><strong style="font-size: 18px">Numbers said as words</strong><span style="font-size: 16px; line-height: 1.6; color: var(--kv-ink-2)">“Nau aath chaar paanch” has no digits for a regex to find. Kavach recognises spoken numbers in every language it supports.</span></div>
<div class="rv" style="display: flex; flex-direction: column; gap: 6px"><strong style="font-size: 18px">Indian ID formats</strong><span style="font-size: 16px; line-height: 1.6; color: var(--kv-ink-2)">Aadhaar, PAN, IFSC, UPI and ABHA are checked with their real validators, so they are caught without flagging every 12-digit number.</span></div>
</div>
</section>

<!-- LANGUAGE PICKER -->
<section id="languages" style="max-width: 1200px; margin: 0 auto; padding: 40px 24px 112px">
<div class="rv" style="display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-start">
<div style="flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 18px">
<div style="position: relative; display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; padding-top: 12px; font-size: 15px; font-weight: 600"><span class="kv-sh-line" aria-hidden="true" style="position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--kv-ink); transform-origin: 0 50%"></span><span style="display: flex; align-items: baseline; gap: 12px"><span lang="hi" style="font-family: 'Anek Devanagari Variable', sans-serif; font-size: 18px; color: var(--kv-indigo)">०२</span><span>Languages</span></span><span style="font-family: 'JetBrains Mono Variable', monospace; font-size: 13px; font-weight: 400; color: var(--kv-muted)">02 / 09</span></div>
<h2 style="margin: 0; font-family: 'Anek Latin Variable', sans-serif; font-weight: 650; font-stretch: 85%; font-size: 36px; line-height: 1.08">Pick a language</h2>
<div role="group" aria-label="Language" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(112px, 1fr)); gap: 8px" data-island="langGrid" set:html={html.langGrid}></div>
</div>
<div style="flex: 1 1 520px; min-width: 0; background: var(--kv-paper); border: 1px solid var(--kv-line); border-radius: 10px; padding: 28px; display: flex; flex-direction: column; gap: 22px" data-island="langCard" set:html={html.langCard}></div>
</div>
</section>

<!-- PRODUCTS -->
<section id="products" class="kv-prod" style="border-top: 1px solid var(--kv-line)">
<div style="max-width: 1200px; margin: 0 auto; padding: 112px 24px; display: flex; flex-direction: column; gap: 40px">
<div class="rv" style="display: flex; flex-direction: column; gap: 18px">
<div style="position: relative; display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; padding-top: 12px; font-size: 15px; font-weight: 600"><span class="kv-sh-line" aria-hidden="true" style="position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--kv-ink); transform-origin: 0 50%"></span><span style="display: flex; align-items: baseline; gap: 12px"><span lang="hi" style="font-family: 'Anek Devanagari Variable', sans-serif; font-size: 18px; color: var(--kv-indigo)">०३</span><span>Products</span></span><span style="font-family: 'JetBrains Mono Variable', monospace; font-size: 13px; font-weight: 400; color: var(--kv-muted)">03 / 09</span></div>
<h2 style="margin: 0; font-family: 'Anek Latin Variable', sans-serif; font-weight: 650; font-stretch: 85%; font-size: clamp(34px, 4.4vw, 54px); line-height: 1.04; letter-spacing: -0.015em; max-width: 760px">You get back the same format you sent in.</h2>
<p style="margin: 0; font-size: 18px; line-height: 1.6; color: var(--kv-ink-2); max-width: 720px">Most tools hand you a list of PII spans and leave the rest to you. Kavach returns finished output you can use straight away.</p>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-start">
<div style="flex: 1 1 440px; min-width: 0; display: flex; flex-direction: column; border-top: 1px solid var(--kv-ink)">
<a class="kv-pitem kv-p1 kv-row" href={u('relay/')} style="text-decoration: none; color: var(--kv-ink); display: flex; flex-direction: column; justify-content: center; gap: 14px; padding: 40px 12px; border-bottom: 1px solid var(--kv-line)"><span style="font-family: 'JetBrains Mono Variable', monospace; font-size: 13px; color: var(--kv-muted)">Agent → LLM → agent</span><span style="font-family: 'Anek Latin Variable', sans-serif; font-weight: 650; font-stretch: 85%; font-size: 40px; line-height: 1">Kavach Relay</span><span style="font-size: 18px; line-height: 1.6; color: var(--kv-ink-2); max-width: 520px">A gateway between your agents and external LLMs, tools and partner agents. Real values become tokens going out and are restored coming back.</span><span class="kv-inline-vis" aria-hidden="true" style="max-width: 320px; width: 100%; height: 56px; position: relative; display: flex; align-items: center; justify-content: space-between">
<span style="position: absolute; left: 10px; right: 10px; top: 50%; border-top: 1px dashed var(--kv-stone-dark)"></span>
<span style="position: relative; width: 14px; height: 14px; border-radius: 50%; background: var(--kv-paper); border: 2px solid var(--kv-ink)"></span>
<span class="kv-flow" style="position: absolute; left: 24px; top: 17px; font-family: 'JetBrains Mono Variable', monospace; font-size: 11px; background: var(--kv-indigo); color: var(--kv-khadi); padding: 3px 6px; border-radius: 3px">PERSON_1</span>
<span style="position: relative; width: 14px; height: 14px; border-radius: 50%; background: var(--kv-paper); border: 2px solid var(--kv-ink)"></span>
</span><span style="font-weight: 600; color: var(--kv-indigo)">View Relay →</span></a>
<a class="kv-pitem kv-p2 kv-row" href={u('voice/')} style="text-decoration: none; color: var(--kv-ink); display: flex; flex-direction: column; justify-content: center; gap: 14px; padding: 40px 12px; border-bottom: 1px solid var(--kv-line)"><span style="font-family: 'JetBrains Mono Variable', monospace; font-size: 13px; color: var(--kv-muted)">Audio → audio</span><span style="font-family: 'Anek Latin Variable', sans-serif; font-weight: 650; font-stretch: 85%; font-size: 40px; line-height: 1">Kavach Voice</span><span style="font-size: 18px; line-height: 1.6; color: var(--kv-ink-2); max-width: 520px">Live calls and recordings come back as the same audio, with spoken PII beeped, silenced or voiced over, plus a masked transcript.</span><span class="kv-inline-vis" aria-hidden="true" style="max-width: 320px; width: 100%; height: 56px; display: flex; align-items: center; gap: 3px" set:html={html.voiceMini}></span><span style="font-weight: 600; color: var(--kv-indigo)">View Voice →</span></a>
<a class="kv-pitem kv-p3 kv-row" href={u('vision/')} style="text-decoration: none; color: var(--kv-ink); display: flex; flex-direction: column; justify-content: center; gap: 14px; padding: 40px 12px; border-bottom: 1px solid var(--kv-line)"><span style="font-family: 'JetBrains Mono Variable', monospace; font-size: 13px; color: var(--kv-muted)">Image → image</span><span style="font-family: 'Anek Latin Variable', sans-serif; font-weight: 650; font-stretch: 85%; font-size: 40px; line-height: 1">Kavach Vision</span><span style="font-size: 18px; line-height: 1.6; color: var(--kv-ink-2); max-width: 520px">Scans, phone photos and PDFs come back with the layout intact and details covered, including faces, signatures and Aadhaar QR codes.</span><span class="kv-inline-vis" aria-hidden="true" style="max-width: 320px; width: 100%; height: 56px; position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: center; gap: 7px; padding: 0 8px; background: var(--kv-paper); border: 1px solid var(--kv-line); border-radius: 4px">
<span style="display: flex; gap: 6px"><span style="width: 40px; height: 6px; background: var(--kv-stone-light); border-radius: 2px"></span><span style="width: 90px; height: 6px; background: var(--kv-indigo); border-radius: 2px"></span></span>
<span style="display: flex; gap: 6px"><span style="width: 56px; height: 6px; background: var(--kv-stone-light); border-radius: 2px"></span><span style="width: 70px; height: 6px; background: var(--kv-indigo); border-radius: 2px"></span><span style="width: 30px; height: 6px; background: var(--kv-stone-light); border-radius: 2px"></span></span>
<span class="kv-scan" style="position: absolute; left: 0; right: 0; top: 40%; height: 2px; background: var(--kv-vermilion); opacity: 0.7"></span>
</span><span style="font-weight: 600; color: var(--kv-indigo)">View Vision →</span></a>
</div>
<div class="kv-prod-panel" aria-hidden="true" style="display: none; flex: 1 1 520px; min-width: 0">
<div class="kv-prod-pin" style="position: relative; height: 460px; background: var(--kv-paper); border: 1px solid var(--kv-line); border-radius: 10px; overflow: hidden; box-shadow: 0 30px 60px -36px rgba(22, 26, 46, 0.35)">
<div class="kv-pv kv-pv1" style="position: absolute; inset: 0; padding: 32px; display: flex; flex-direction: column; justify-content: center; gap: 16px"><div style="display: flex; justify-content: space-between; font-family: 'JetBrains Mono Variable', monospace; font-size: 13px; color: var(--kv-muted)"><span>support-agent → external LLM</span><span>agent → LLM → agent</span></div><div style="padding: 14px 16px; border: 1px solid var(--kv-line); border-radius: 6px; display: flex; flex-direction: column; gap: 4px"><span style="font-family: 'JetBrains Mono Variable', monospace; font-size: 13px; color: var(--kv-muted)">Your agent</span><span style="font-size: 17px; line-height: 1.7">Book a follow-up for <span style="background: rgba(194, 65, 12, 0.12); border-bottom: 2px solid var(--kv-vermilion); padding: 0 2px">Rohit Sharma</span>, phone <span style="background: rgba(194, 65, 12, 0.12); border-bottom: 2px solid var(--kv-vermilion); padding: 0 2px">98860 22113</span>.</span></div><div aria-hidden="true" style="position: relative; height: 34px; overflow: hidden"><span style="position: absolute; left: 24px; top: 0; bottom: 0; border-left: 1px dashed var(--kv-muted)"></span><span class="kv-flow" style="position: absolute; left: 36px; top: 8px; font-family: 'JetBrains Mono Variable', monospace; font-size: 11px; background: var(--kv-indigo); color: var(--kv-khadi); padding: 2px 6px; border-radius: 3px">PERSON_1</span></div><div style="padding: 14px 16px; background: var(--kv-khadi); border: 1px solid var(--kv-line); border-radius: 6px; display: flex; flex-direction: column; gap: 4px"><span style="font-family: 'JetBrains Mono Variable', monospace; font-size: 13px; color: var(--kv-muted)">What the LLM receives</span><span style="font-size: 17px; line-height: 1.7">Book a follow-up for <span style="background: var(--kv-indigo); color: var(--kv-khadi); padding: 2px 7px; border-radius: 3px; font-family: 'JetBrains Mono Variable', monospace; font-size: 13px; white-space: nowrap">P