---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
import { renderAll } from '../lib/dc';
import { Component } from '../logic/relay.js';
const tpl = import.meta.glob('../templates/relay/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const html = renderAll(new Component({}), tpl);
---
<Base title="Kavach Relay \u00b7 Privacy gateway for AI agents" description="A gateway between your AI agents and external LLMs, MCP tools and partner agents. Personal data becomes tokens on the way out and is restored on the way back." current="relay/" height={5600}>
<!-- HERO -->
<section style="max-width: 1200px; margin: 0 auto; padding: 72px 24px 48px; display: flex; flex-direction: column; gap: 22px">
<p style="margin: 0; font-family: 'JetBrains Mono Variable', monospace; font-size: 14px; color: var(--kv-ink-2)">Kavach Relay · privacy gateway for AI agents</p>
<h1 style="margin: 0; font-family: 'Anek Latin Variable', sans-serif; font-weight: 650; font-stretch: 85%; font-size: clamp(44px, 6vw, 80px); line-height: 0.98; letter-spacing: -0.02em; max-width: 1000px; text-wrap: balance">Your agents share more than you think. Relay decides what leaves.</h1>
<p style="margin: 0; font-size: 20px; line-height: 1.55; color: var(--kv-ink-2); max-width: 740px; text-wrap: pretty">Relay is a gateway between your agents and everything outside your network: LLM APIs, MCP tools and other companies’ agents. It swaps personal data for tokens on the way out and puts the real values back on the way in, so your agents keep working normally.</p>
<div style="display: flex; flex-wrap: wrap; gap: 12px">
<a class="kv-btn" href={u('pilot/')} style="background: var(--kv-indigo); color: var(--kv-paper); text-decoration: none; padding: 15px 24px; border-radius: 6px; font-weight: 600; font-size: 17px">Book a pilot for Relay</a>
<a class="kv-btn2" href="#arch" style="color: var(--kv-ink); text-decoration: none; padding: 14px 24px; border-radius: 6px; font-weight: 600; font-size: 17px; border: 1px solid var(--kv-ink)">See the architecture</a>
</div>
</section>

<!-- POLICY DEMO -->
<section style="max-width: 1200px; margin: 0 auto; padding: 0 24px 112px">
<div style="background: var(--kv-paper); border: 1px solid var(--kv-line); border-radius: 10px; box-shadow: 0 30px 60px -36px rgba(22, 26, 46, 0.35); overflow: hidden" data-island="demo" set:html={html.demo}></div>
</section>


<!-- WHERE AGENTS LEAK -->
<section style="border-top: 1px solid var(--kv-line)">
<div style="max-width: 1200px; margin: 0 auto; padding: 104px 24px; display: flex; flex-direction: column; gap: 36px">
<h2 class="rv" style="margin: 0; font-family: 'Anek Latin Variable', sans-serif; font-weight: 650; font-stretch: 85%; font-size: clamp(32px, 4vw, 48px); line-height: 1.04; max-width: 820px">Agents leak without anyone deciding to.</h2>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 0 40px">
<article class="rv" style="display: flex; flex-direction: column; gap: 10px; padding: 24px 0; border-top: 2px solid var(--kv-ink)"><span style="font-family: 'JetBrains Mono Variable', monospace; font-size: 13px; color: var(--kv-vermilion-deep)">The context window</span><strong style="font-size: 20px; line-height: 1.3">The whole record went along</strong><span style="font-size: 16px; line-height: 1.65; color: var(--kv-ink-2)">An agent fetches a customer record to answer one question, and the full record, Aadhaar number included, ends up in the prompt to an external model.</span></article>
<article class="rv" style="display: flex; flex-direction: column; gap: 10px; padding: 24px 0; border-top: 2px solid var(--kv-ink)"><span style="font-family: 'JetBrains Mono Variable', monospace; font-size: 13px; color: var(--kv-vermilion-deep)">Tool calls</span><strong style="font-size: 20px; line-height: 1.3">The tool got more than it needed</strong><span style="font-size: 16px; line-height: 1.65; color: var(--kv-ink-2)">A calendar or CRM tool only needs a name and a slot, but the agent passes everything it knows. Tool results can carry personal data back in, too.</span></article>
<article class="rv" style="display: flex; flex-direction: column; gap: 10px; padding: 24px 0; border-top: 2px solid var(--kv-ink)"><span style="font-family: 'JetBrains Mono Variable', monospace; font-size: 13px; color: var(--kv-vermilion-deep)">Agent to agent</span><strong style="font-size: 20px; line-height: 1.3">The partner’s agent saw the customer</strong><span style="font-size: 16px; line-height: 1.65; color: var(--kv-ink-2)">Your agent negotiates with an insurer’s or lender’s agent and shares the conversation as it is. The partner now holds data your agreement never covered.</span></article>
</div>
</div>
</section>

<!-- ARCHITECTURE -->
<section id="arch" style="background: rgba(239, 235, 224, 0.72); border-top: 1px solid var(--kv-line); border-bottom: 1px solid var(--kv-line)">
<div style="max-width: 1200px; margin: 0 auto; padding: 104px 24px; display: flex; flex-direction: column; gap: 40px">
<h2 class="rv" style="margin: 0; font-family: 'Anek Latin Variable', sans-serif; font-weight: 650; font-stretch: 85%; font-size: clamp(32px, 4vw, 48px); line-height: 1.04">One gateway on every way out.</h2>
<div class="rv" style="display: flex; flex-wrap: wrap; align-items: stretch; gap: 0">
<div style="flex: 1 1 220px; min-width: 0; padding: 20px; border: 1px dashed var(--kv-stone-dark); border-radius: 8px; display: flex; flex-direction: column; gap: 10px; background: var(--kv-khadi)">
<span style="font-size: 14px; font-weight: 600; color: var(--kv-ink-2)">Inside your network</span>
<span style="padding: 12px 14px; background: var(--kv-paper); border: 1px solid var(--kv-line); border-radius: 4px">Support agents</span>
<span style="padding: 12px 14px; background: var(--kv-paper); border: 1px solid var(--kv-line); border-radius: 4px">Employee copilots</span>
<span style="padding: 12px 14px; background: var(--kv-paper); border: 1px solid var(--kv-line); border-radius: 4px">RAG pipelines</span>
<span style="padding: 12px 14px; background: var(--kv-paper); border: 1px solid var(--kv-line); border-radius: 4px">Back-office workflows</span>
</div>
<div aria-hidden="true" style="flex: 1 1 120px; min-width: 120px; position: relative; display: flex; align-items: center; overflow: hidden; min-height: 60px">
<span style="position: absolute; left: 8px; right: 8px; top: 50%; border-top: 1px dashed var(--kv-muted)"></span>
<span class="kv-flow" style="position: absolute; left: 0; top: calc(50% - 26px); font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; background: rgba(194, 65, 12, 0.14); color: var(--kv-vermilion-deep); border-bottom: 2px solid var(--kv-vermilion); padding: 2px 6px">Rohit</span>
</div>
<div style="flex: 1 1 260px; min-width: 0; background: var(--kv-indigo-deep); color: var(--kv-on-dark); border-radius: 8px; padding: 22px; display: flex; flex-direction: column; gap: 12px">
<strong style="font-family: 'Anek Latin Variable', sans-serif; font-stretch: 85%; font-size: 28px">Kavach Relay</strong>
<span style="font-size: 15px; line-height: 1.6; color: var(--kv-on-dark-2)">Detect, apply the destination’s policy, swap in tokens, forward, then restore the reply for callers you authorise.</span>
<span style="padding: 12px; border: 1px solid var(--kv-indigo-line); border-radius: 4px; font-size: 14px; display: flex; flex-direction: column; gap: 2px"><strong>Token vault</strong><span style="color: var(--kv-on-dark-muted)">Keys in your KMS. Never leaves your network.</span></span>
<span style="padding: 12px; border: 1px solid var(--kv-indigo-line); border-radius: 4px; font-size: 14px; display: flex; flex-direction: column; gap: 2px"><strong>Audit stream</strong><span style="color: var(--kv-on-dark-muted)">Every crossing logged to your SIEM, without values.</span></span>
</div>
<div aria-hidden="true" style="flex: 1 1 120px; min-width: 120px; position: relative; display: flex; align-items: center; overflow: hidden; min-height: 60px">
<span style="position: absolute; left: 8px; right: 8px; top: 50%; border-top: 1px dashed var(--kv-muted)"></span>
<span class="kv-flow" style="position: absolute; left: 0; top: calc(50% - 26px); font-family: 'JetBrains Mono Variable', monospace; font-size: 12px; background: var(--kv-indigo); color: var(--kv-khadi); padding: 3px 6px; border-radius: 3px; animation-delay: 1.8s">PERSON_1</span>
</div>
<div style="flex: 1 1 220px; min-width: 0; padding: 20px; border: 1px dashed var(--kv-stone-dark); border-radius: 8px; display: flex; flex-direction: column; gap: 10px">
<span style="font-size: 14px; font-weight: 600; color: var(--kv-ink-2)">Outside</span>
<span style="padding: 12px 14px; background: var(--kv-paper); border: 1px solid var(--kv-line); border-radius: 4px">Frontier LLM APIs</span>
<span style="padding: 12px 14px; background: var(--kv-paper); border: 1px solid var(--kv-line); border-radius: 4px">MCP servers and SaaS tools</span>
<span style="padding: 12px 14px; background: var(--kv-paper); border: 1px solid var(--kv-line); border-radius: 4px">Partner agents (A2A)</span>
<span style="padding: 12px 14px; background: var(--kv-paper); border: 1px solid var(--kv-line); border-radius: 4px">Vendors and observability</span>
</div>
</div>
</div>
</section>

<!-- FEATURES -->
<section style="max-width: 1200px; margin: 0 auto; padding: 104px 24px; display: flex; flex-direction: column; gap: 32px">
<h2 class="rv" style="margin: 0; font-family: 'Anek Latin Variable', sans-serif; font-weight: 650; font-stretch: 85%; font-size: clamp(32px, 4vw, 48px); line-height: 1.04">Built for how agents actually work</h2>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 0 40px">
<div class="rv" style="display: flex; flex-direction: column; gap: 6px; padding: 22px 0; border-top: 1px solid var(--kv-line)"><strong style="font-size: 18px">Drop-in endpoint</strong><span style="font-size: 16px; line-height: 1.6; color: var(--kv-ink-2)">OpenAI- and Anthropic-compatible APIs. Change one base URL and keep your SDKs.</span></div>
<div class="rv" style="display: flex; flex-direction: column; gap: 6px; padding: 22px 0; border-top: 1px solid var(--kv-line)"><strong style="font-size: 18px">Consistent tokens</strong><span style="font-size: 16px; line-height: 1.6; color: var(--kv-ink-2)">Rohit stays PERSON_1 across every turn, tool call and agent in a session, so reasoning holds up.</span></div>
<div class="rv" style="display: flex; flex-direction: column; gap: 6px; padding: 22px 0; border-top: 1px solid var(--kv-line)"><strong style="font-size: 18px">Streaming restore</strong><span style="font-size: 16px; line-height: 1.6; color: var(--kv-ink-2)">Tokens are swapped back as the response streams, with no wait for the full answer.</span></div>
<div class="rv" style="display: flex; flex-direction: column; gap: 6px; padding: 22px 0; border-top: 1px solid var(--kv-line)"><strong style="font-size: 18px">MCP-aware</strong><span style="font-size: 16px; line-height: 1.6; color: var(--kv-ink-2)">Inspects tool arguments and tool results, not just prompts. Policy per server and per tool.</span></div>
<div class="rv" style="display: flex; flex-direction: column; gap: 6px; padding: 22px 0; border-top: 1px solid var(--kv-line)"><strong style="font-size: 18px">Balanced mode</strong><span style="font-size: 16px; line-height: 1.6; color: var(--kv-ink-2)">Leaves non-personal context alone so the model still has enough to do the task well.</span></div>
<div class="rv" style="display: flex; flex-direction: column; gap: 6px; padding: 22px 0; border-top: 1px solid var(--kv-line)"><strong style="font-size: 18px">Role-based unmask</strong><span style="font-size: 16px; line-height: 1.6; color: var(--kv-ink-2)">Only callers you authorise get real values back. Everyone else sees tokens.</span></div>
</div>
</section>

<!-- USE CASES -->
<section style="border-top: 1px solid var(--kv-line)">
<div style="max-width: 1200px; margin: 0 auto; padding: 104px 24px; display: flex; flex-direction: column; gap: 32px">
<h2 class="rv" style="margin: 0; font-family: 'Anek Latin Variable', sans-serif; font-weight: 650; font-stretch: 85%; font-size: clamp(32px, 4vw, 48px); line-height: 1.04">Where teams use Relay</h2>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 0 40px">
<div class="rv" style="display: flex; flex-direction: column; gap: 6px; padding: 22px 0; border-top: 1px solid var(--kv-line)"><strong style="font-size: 18px">Customer-service agents</strong><span style="font-size: 16px; line-height: 1.6; color: var(--kv-ink-2)">Resolve tickets with frontier models while account details stay on-prem.</span></div>
<div class="rv" style="display: flex; flex-direction: column; gap: 6px; padding: 22px 0; border-top: 1px solid var(--kv-line)"><strong style="font-size: 18px">Underwriting assistants</strong><span style="font-size: 16px; line-height: 1.6; color: var(--kv-ink-2)">Let models reason over applications without seeing who applied.</span></div>
<div class="rv" style="display: flex; flex-direction: column; gap: 6px; padding: 22px 0; border-top: 1px solid var(--kv-line)"><strong style="font-size: 18px">Insurer-to-hospital agents</strong><span style="font-size: 16px; line-height: 1.6; color: var(--kv-ink-2)">Pre-authorisation between organisations, sharing only the fields each side needs.</span></div>
<div class="rv" style="display: flex; flex-direction: column; gap: 6px; padding: 22px 0; border-top: 1px solid var(--kv-line)"><strong style="font-size: 18px">RAG without PII in the index</strong><span style="font-size: 16px; line-height: 1.6; color: var(--kv-ink-2)">Documents are tokenised before they reach your vector store and restored when an answer is shown.</span></div>
<div class="rv" style="display: flex; flex-direction: column; gap: 6px; padding: 22px 0; border-top: 1px solid var(--kv-line)"><strong style="font-size: 18px">Prompt and trace logging</strong><span style="font-size: 16px; line-height: 1.6; color: var(--kv-ink-2)">Send clean traces to observability and eval tools without a privacy review each time.</span></div>
<div class="rv" style="display: flex; flex-direction: column; gap: 6px; padding: 22px 0; border-top: 1px solid var(--kv-line)"><strong style="font-size: 18px">WhatsApp and chat assistants</strong><span style="font-size: 16px; line-height: 1.6; color: var(--kv-ink-2)">Hinglish, Tamil or Marathi chats reach the model masked, and replies come back with real names.</span></div>
</div>
</div>
</section>

<!-- CTA -->
<section style="position: relative; overflow: hidden; background: var(--kv-indigo-deep); color: var(--kv-on-dark)">
<div class="kv-scales" aria-hidden="true"></div>
<div style="position: relative; max-width: 1200px; margin: 0 auto; padding: 104px 24px; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 32px">
<div class="rv" style="display: flex; flex-direction: column; gap: 12px; max-width: 700px">
<h2 style="margin: 0; font-family: 'Anek Latin Variable', sans-serif; font-weight: 650; font-stretch: 85%; font-size: clamp(34px, 4.4vw, 54px); line-height: 1.04">Put Relay in front of one agent this month.</h2>
<p style="margin: 0; font-size: 18px; line-height: 1.6; color: var(--kv-on-dark-2)">Free 90-day pilot. One base URL change, no code rewrite.</p>
</div>
<a class="kv-btn2" href={u('pilot/')} style="background: var(--kv-khadi); color: var(--kv-indigo-deep); text-decoration: none; padding: 16px 26px; border-radius: 6px; font-weight: 600; font-size: 17px; border: 1px solid var(--kv-khadi)">Book a pilot</a>
</div>
</section>
</Base>

<script>
import { mount } from '../lib/dc';
import { Component } from '../logic/relay.js';
const tpl = import.meta.glob('../templates/relay/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
mount(new Component({}), tpl);
</script>
